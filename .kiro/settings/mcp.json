{
  "mcpServers": {
    "basic-memory": {
      "command": "basic-memory",
      "args": ["mcp"],
      "env": {
        "BASIC_MEMORY_NO_PROMOS": "1"
      },
      "disabled": false,
      "autoApprove": [
        "search_notes",
        "read_note",
        "view_note",
        "read_content",
        "build_context",
        "recent_activity",
        "list_directory",
        "list_memory_projects",
        "basic_memory_diagnostics"
      ],
      "disabledTools": [
        "delete_note",
        "delete_project"
      ]
    }
  }
}
