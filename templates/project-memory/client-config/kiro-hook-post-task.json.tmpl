{
  "version": "v1",
  "hooks": [
    {
      "name": "project-memory-push",
      "description": "After each agent turn: commit changed notes under memory/ and push to the current branch's upstream. No-op when nothing changed; stops on merge conflict; never force-pushes.",
      "trigger": "Stop",
      "action": { "type": "command", "command": "uv run -q --script memory/scripts/sync-memory.py post --agent" },
      "timeout": 120,
      "confirm": false
    }
  ]
}
