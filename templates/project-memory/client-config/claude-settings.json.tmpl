{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run -q --script memory/scripts/sync-memory.py:*)",
      "Bash(uv run -q --script memory/scripts/mem.py:*)",
      "Bash(uv run -q --script memory/scripts/memory_guard.py:*)",
      "mcp__basic-memory__search_notes",
      "mcp__basic-memory__read_note",
      "mcp__basic-memory__view_note",
      "mcp__basic-memory__build_context",
      "mcp__basic-memory__recent_activity",
      "mcp__basic-memory__list_directory",
      "mcp__basic-memory__list_memory_projects"
    ],
    "deny": [
      "mcp__basic-memory__delete_note",
      "mcp__basic-memory__delete_project",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --no-verify:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --script memory/scripts/sync-memory.py pre --agent",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "uv run -q --script memory/scripts/mem.py --hook session start",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --script memory/scripts/mem.py --hook session evict",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --script memory/scripts/mem.py --hook moved --quiet --fetch --throttle 300",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run -q --script memory/scripts/sync-memory.py post --agent",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
